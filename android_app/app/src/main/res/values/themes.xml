<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CropDisease" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="colorSecondaryContainer">@color/brand_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_primary_container</item>
        <item name="colorError">@color/error_text</item>

        <item name="android:colorBackground">@color/page_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Reusable text roles, so screen headers/subheads stay consistent
         instead of one-off textSize/textColor pairs on every TextView. -->
    <style name="TextAppearance.CropDisease.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CropDisease.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.CropDisease.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.CropDisease.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- One shared look for every "section card" (login form, upload
         sections, history rows) instead of restating card attrs per file. -->
    <style name="Widget.CropDisease.SectionCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.CropDisease.PrimaryButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- A secondary action button that fills with the brand color instead
         of using it as text (gold-as-text fails contrast on light — see
         colors.xml). Use for anything that would otherwise be an
         OutlinedButton with brand-colored text. -->
    <style name="Widget.CropDisease.SecondaryButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Plain text buttons/links, in the readable accent_text color rather
         than the default TextButton's raw colorPrimary (same contrast
         reason as above). -->
    <style name="Widget.CropDisease.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/accent_text</item>
        <item name="iconTint">@color/accent_text</item>
    </style>

    <style name="Widget.CropDisease.OutcomeChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
    </style>
</resources>
