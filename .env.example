# Template for .env — copy to .env and fill in real values. .env itself is
# gitignored and must never be committed with real secrets.

# --- Auth — required; api/auth.py raises RuntimeError if this is empty.
# Generate a fresh one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# First ADMIN account — only used by storage/init_db.py when the users table is empty.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Database — omit for local dev (defaults to SQLite at storage/app.db).
# For the demo/submission (manual 5.3 requires PostgreSQL, not SQLite): bring
# up `docker compose up -d` (see docker-compose.yml) and set:
# DATABASE_URL=postgresql+psycopg2://ews_user:ews_password@127.0.0.1:5432/crop_disease

# --- Kafka — the local file-queue fallback (kafka/producer.py) is an
# infrastructure convenience for dev/test only. For a real demo, run an
# actual Kafka broker and set this to false so a broker outage is loud
# instead of silently falling back:
# KAFKA_USE_LOCAL_FALLBACK=false

# --- Spark on Windows — full path to the interpreter so executor Python
# workers don't hit the Microsoft Store alias stub. Adjust to your machine.
PYSPARK_PYTHON=
PYSPARK_DRIVER_PYTHON=

# --- Google Drive (Android -> Drive -> Kafka -> Spark -> Drive -> Android) ---
# Run `python scripts/drive_authorize.py` once; it writes the token and the
# folder IDs automatically. Set these only to override the default paths/IDs.
# GOOGLE_DRIVE_CLIENT_SECRET_FILE=storage/google_client_secret.json
# GOOGLE_DRIVE_TOKEN_FILE=storage/google_drive_token.json
# GOOGLE_DRIVE_FOLDERS_FILE=storage/google_drive_folders.json
# GOOGLE_DRIVE_ROOT_FOLDER_NAME=CropDiseaseEWS
# GOOGLE_DRIVE_IMAGES_FOLDER_ID=
# GOOGLE_DRIVE_RESULTS_FOLDER_ID=
# Drive watcher follows Drive's change feed: one request per check.
# DRIVE_WATCH_INTERVAL_SECONDS=2        # while uploads arrive
# DRIVE_WATCH_IDLE_SECONDS=9            # slowest, when quiet
# DRIVE_WATCH_FULL_SCAN_SECONDS=600     # safety-net full folder search
#
# Processing speed (spark/streaming_job.py, ml/inference.py)
# MODEL_DEVICE=auto                     # auto = RTX GPU if PyTorch has CUDA, else CPU; or cuda / cpu
# SPARK_TRIGGER_SECONDS=1
# SPARK_PARALLEL_PHOTOS=4
# ANALYSIS_MAX_PX=1280
# DASHBOARD_REFRESH_SECONDS=10   # Real-Time Monitoring auto-refresh; 0 = off
